      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(git fetch)",
      "PowerShell(git fetch *)",
      "PowerShell(git remote -v)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push)",
      "PowerShell(git push origin *)",
      "PowerShell(git pull)",
      "PowerShell(git pull *)",
      "PowerShell(git switch *)",
      "PowerShell(git switch -c *)",
      "PowerShell(gh issue create*)",
      "PowerShell(gh issue list*)",
      "PowerShell(gh issue view*)",
      "PowerShell(gh issue comment*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh pr diff*)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git push --force*)",
