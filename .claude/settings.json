      "Bash(git push origin master*)",
      "Bash(git push origin main*)",
      "Bash(git push * master)",
      "Bash(git push * main)",
      "Bash(git push --all*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git rebase*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api repos/* --method DELETE*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(mv *)",
      "PowerShell(Move-Item*)",
      "PowerShell(git rm *)",
      "PowerShell(git mv *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push origin master*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push * master)",
      "PowerShell(git push * main)",
      "PowerShell(git push --all*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git rebase*)",
      "PowerShell(gh pr merge * --admin*)",
      "PowerShell(gh api repos/* --method DELETE*)"
